# DEEN DRIP ENVIRONMENT VARIABLES CONFIGURATION

# Base application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API Key (Optional progressive enhancement)
# Used for Google Places address autocomplete at checkout and live interactive delivery route maps.
# If not provided, checkout operates smoothly with manual address input and high-aesthetic route monitor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Paystack API Keys (Payment Processing)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
